# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.db
*.sqlite3

# Node / web
node_modules/
apps/web/dist/
apps/web/.vite/
*.local

# Claude Code — machine-local permission allowances only.
# The committed, reviewed configuration is .claude/settings.json (hooks + deny rules).
# This file was previously ignored only via .git/info/exclude, which does not travel
# to other clones; tracking the rule here closes that gap.
.claude/settings.local.json

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Secrets — never commit real secrets (Charter §13)
.env
.env.*
!.env.example
secrets/
*.pem
*.key
