{
  "name": "secp-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SECP-001 control-plane web app (React + TypeScript).",
  "scripts": {
    "dev": "vite --host --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 5173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "generate:api": "node scripts/generate-api-types.mjs",
    "generate:api:check": "node scripts/generate-api-types.mjs --check",
    "generate:api-docs": "node --experimental-strip-types scripts/generate-unsourced-fields.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "@rive-app/react-webgl2": "^4.29.5",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elkjs": "^0.11.1",
    "gsap": "^3.15.0",
    "js-yaml": "^4.1.0",
    "lucide-react": "^1.25.0",
    "oidc-client-ts": "^3.5.0",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^6.26.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@types/three": "^0.185.3",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitejs/plugin-react": "^6.0.3",
    "axe-core": "^4.12.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.12",
    "jsdom": "^26.1.0",
    "openapi-typescript": "7.13.0",
    "semver": "^7.8.5",
    "typescript": "^5.6.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
